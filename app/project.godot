config_version=5

[application]

config/name="WoB Model Viewer"
config/version="1.5.7"
run/main_scene="res://viewer.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://art/icon.png"
config/windows_native_icon="res://art/icon.ico"
boot_splash/image="res://art/startup.png"
boot_splash/bg_color=Color(0.067, 0.071, 0.078, 1)
boot_splash/minimum_display_time=450

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1360
window/size/window_height_override=850
window/size/mode=2
window/subwindows/embed_subwindows=true

[internationalization]

locale/fallback="cs"
locale/translations=PackedStringArray("res://locale/en.po", "res://tools/en.po")

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.036, 0.045, 0.06, 1)
